{
  "name": "daily-noodle",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tools/tests/suite.js",
    "test:unit": "node --test tools/tests/unit/*.test.js",
    "test:content": "node tools/tests/content.js",
    "test:backend": "node --test tools/tests/backend.test.js",
    "test:browser": "node tools/tests/browser-run.js",
    "test:puzzles": "node tools/tests/run.js",
    "test:offline": "node tools/tests/sw.js",
    "test:visual": "node tools/tests/browser-run.js --project=chromium visual.spec.js",
    "test:visual:update": "node tools/tests/browser-run.js --project=chromium visual.spec.js --update-snapshots",
    "test:nightly": "node tools/tests/suite.js --nightly",
    "build:test": "node tools/tests/build.js",
    "test:live": "node tools/tests/live.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/noto-emoji": "5.3.2",
    "@fontsource/nunito": "5.3.0",
    "@playwright/test": "1.62.1",
    "@sparticuz/chromium": "153.0.0",
    "axe-core": "4.14.0"
  }
}
